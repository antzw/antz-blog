---
import { getCollection } from "astro:content";
import BlogCard from "../components/BlogCard.astro";
import Layout from "../layouts/Layout.astro";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const latestPosts = posts.slice(0, 3);
const tags = [...new Set(posts.flatMap((post) => post.data.tags ?? []))].slice(0, 6);
---

<Layout title="AntZ Blog" description="记录思考、构建知识、探索可能。">
  <div class="page-stack">
    <section class="panel hero-panel home-hero">
      <div class="home-hero__content">
        <div class="section-grid">
          <p class="eyebrow">Personal Publishing</p>
          <h1 class="hero-title">欢迎来到 AntZ 的博客。</h1>
          <p class="muted home-hero__lead">
            这里记录建站、Astro、AI 实验和个人思考。新版首页去掉了重背景图，改成更轻快的内容入口，打开更快，也更聚焦阅读。
          </p>
        </div>

        <div class="home-hero__actions">
          <a class="button-link" href="/blog">进入博客</a>
          <a class="button-link button-link--ghost" href="/llm">打开 AI 实验室</a>
        </div>
      </div>

      <div class="chip-list">
        {tags.map((tag) => (
          <span class="chip">#{tag}</span>
        ))}
      </div>
    </section>

    <section class="home-grid">
      <article class="panel spotlight">
        <p class="eyebrow">About</p>
        <h2>清楚的大版面，服务于内容本身。</h2>
        <p class="muted">
          这次改版重点是减少装饰性负担，让文章入口、标签体系和阅读区更直接。视觉明快，但不会喧宾夺主。
        </p>
      </article>

      <article class="panel spotlight spotlight--accent">
        <p class="eyebrow">Contact</p>
        <h2>保持联系</h2>
        <div class="spotlight__links">
          <a href="mailto:wen_study@outlook.com">wen_study@outlook.com</a>
          <a href="https://github.com/antzw" target="_blank" rel="noreferrer">github.com/antzw</a>
          <a href="https://antz.fun" target="_blank" rel="noreferrer">antz.fun</a>
        </div>
      </article>
    </section>

    <section class="post-section">
      <div class="post-section__header">
        <div>
          <p class="eyebrow">Latest Posts</p>
          <h2>最近更新</h2>
        </div>
        <p class="muted">从最新发布的文章开始浏览。</p>
      </div>

      <div class="post-grid">
        {latestPosts.map((post) => (
          <BlogCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            cover={post.data.cover}
            tags={post.data.tags}
            href={`/blog/${post.slug}/`}
          />
        ))}
      </div>
    </section>
  </div>
</Layout>

<style>
  .home-hero {
    display: grid;
    gap: 1.5rem;
  }

  .home-hero__content {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    align-items: end;
  }

  .home-hero__lead {
    max-width: 50rem;
    font-size: 1.05rem;
  }

  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .home-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 1rem;
  }

  .spotlight {
    display: grid;
    gap: 0.85rem;
    padding: 1.35rem;
  }

  .spotlight--accent {
    background: linear-gradient(145deg, rgba(255, 255, 255, 0.88), rgba(223, 240, 255, 0.86));
  }

  .spotlight__links {
    display: grid;
    gap: 0.65rem;
  }

  .spotlight__links a {
    color: var(--accent-strong);
    font-weight: 600;
  }

  .post-section {
    display: grid;
    gap: 1rem;
  }

  .post-section__header {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 1rem;
  }

  .post-section__header h2 {
    margin-top: 0.45rem;
  }

  .post-grid {
    display: grid;
    gap: 1rem;
  }

  @media (max-width: 900px) {
    .home-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 720px) {
    .home-hero__content,
    .post-section__header {
      flex-direction: column;
      align-items: start;
    }
  }
</style>
