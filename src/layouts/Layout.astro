---
import "../styles/global.css";
import BackToTop from "../components/BackToTop.astro";
import ContactLinks from "../components/ContactLinks.astro";
import ThemeToggle from "../components/ThemeToggle.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "AntZ Blog",
  description = "记录思考、构建知识、探索可能。",
} = Astro.props;

const pathname = Astro.url.pathname;
const navItems = [
  { href: "/", label: "/" },
  { href: "/blog", label: "博客" },
  { href: "/projects", label: "项目" },
  { href: "/papers", label: "论文" },
  { href: "/resume", label: "简历" },
];
---
<!-- Layout component: global shell, header/navigation, page slot, footer, and utilities like theme toggle and back-to-top -->
<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <script is:inline>
      (() => {
        const savedTheme = localStorage.getItem("theme");
        const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        const theme = savedTheme || (prefersDark ? "dark" : "light");
        document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>
  </head>
  <body>
    <!-- Site header: brand + main navigation + theme toggle -->
    <header class="site-header">
      <div class="site-shell">
        <div class="site-header__inner">
          <a class="brand" href="/">
            <img class="brand__icon" src="/cover/antz_icon.png" alt="" width="48" height="48" aria-hidden="true" />
            <span class="brand__text">
              <span class="brand__name">AntZ Blog</span>
              <span class="brand__tagline">简约、清晰、专注内容体验</span>
            </span>
          </a>

          <nav class="site-nav" aria-label="主导航">
            {navItems.map((item) => {
              const isCurrent =
                !item.external &&
                (pathname === item.href || (item.href !== "/" && pathname.startsWith(`${item.href}/`)));
              return (
                <a
                  href={item.href}
                  aria-current={isCurrent ? "page" : undefined}
                  target={item.external ? "_blank" : undefined}
                  rel={item.external ? "noreferrer" : undefined}
                >
                  {item.label}
                </a>
              );
            })}
            <ThemeToggle />
          </nav>
        </div>
      </div>
    </header>

    <!-- Main content area: page-specific content is rendered into the slot -->
    <main class="site-main">
      <div class="site-shell">
        <slot />
      </div>
    </main>

    <!-- Footer: copyright and contact links -->
    <footer class="site-footer">
      <div class="site-shell">
        <div class="site-footer__inner">
          <div class="site-footer__copy">
            <span>© 2026 AntZ. 用 Astro 构建，聚焦写作与学习。</span>
            <span>快速加载、清晰结构、可持续维护。</span>
          </div>
          <ContactLinks />
        </div>
      </div>
    </footer>

    <BackToTop />
  </body>
</html>
