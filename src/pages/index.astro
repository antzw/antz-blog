---
import { getCollection } from "astro:content";
import BlogCard from "../components/BlogCard.astro";
import Layout from "../layouts/Layout.astro";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const latestPosts = posts.slice(0, 3);
const tags = [...new Set(posts.flatMap((post) => post.data.tags ?? []))].slice(0, 6);

const featuredProjects = [
  {
    name: "Astro 个人知识主页",
    description: "围绕博客、项目、论文和简历组织个人公开内容。",
    href: "/projects",
  },
  
  {
    name: "本地 AI 工具实验",
    description: "记录大模型、本地工具链和内容生产流程的探索。",
    href: "/projects",
  },
];
---

<Layout title="AntZ Blog" description="记录思考、构建知识、探索可能。">
  <div class="page-stack">
    <!-- Hero: quick intro and primary actions -->
    <section class="panel hero-panel home-hero">
      <div class="home-hero__content">
        <div class="section-grid">
          <p class="eyebrow">Personal Knowledge Base</p>
          <h2 class="hero-title">AntZ 的博客、项目与研究主页。</h2>
          <p class="muted home-hero__lead">
            这里整理建站、Astro、AI 工具、论文阅读和个人项目。首页作为公开索引，优先让访问者快速判断我在做什么、写什么、能提供什么。
          </p>
        </div>

        <div class="home-hero__actions">
          <a class="button-link" href="/blog">阅读博客</a>
          <a class="button-link button-link--ghost" href="/resume">查看简历</a>
        </div>
      </div>

      <div class="chip-list">
        {tags.map((tag) => (
          <span class="chip">#{tag}</span>
        ))}
      </div>
    </section>

    <!--
      Optional spotlight layout kept here for later reuse.
    <section class="home-grid">
      <article class="panel spotlight">
        <p class="eyebrow">Focus</p>
        <h2>把学习、项目和输出放在同一套信息架构里。</h2>
        <p class="muted">
          当前站点的核心方向是长期写作、项目复盘和研究笔记。博客承载过程，项目页承载结果，论文页承载阅读线索，简历页承载对外展示。
        </p>
      </article>

      <article class="panel spotlight spotlight--accent">
        <p class="eyebrow">Links</p>
        <h2>快速入口</h2>
        <div class="spotlight__links">
          <a href="/projects">项目</a>
          <a href="/papers">论文</a>
          <a href="/resume">简历</a>
          <a href="https://github.com/antzw" target="_blank" rel="noreferrer">github.com/antzw</a>
        </div>
      </article>
    </section>
      -->

    <!-- Projects and research highlights -->
    <section class="home-grid">
      <article class="panel spotlight">
        <p class="eyebrow">Projects</p>
        <h2>精选项目</h2>
        <div class="mini-list">
          {featuredProjects.map((project) => (
            <a href={project.href}>
              <strong>{project.name}</strong>
              <span class="muted">{project.description}</span>
            </a>
          ))}
        </div>
      </article>

      <article class="panel spotlight">
        <p class="eyebrow">Research</p>
        <h2>我的论文</h2>
        <p class="muted">
          论文页先作为阅读索引，后续可以按年份、关键词和主题扩展成更完整的研究笔记库。
        </p>
        <a class="text-link" href="/papers">查看论文索引</a>
      </article>
    </section>

    <!-- Latest blog posts -->
    <section class="post-section">
      <div class="post-section__header">
        <div>
          <p class="eyebrow">Latest Posts</p>
          <h2>最近更新</h2>
        </div>
        <p class="muted">从最新发布的文章开始浏览。</p>
      </div>

      <div class="post-grid">
        {latestPosts.map((post) => (
          <BlogCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            cover={post.data.cover}
            tags={post.data.tags}
            href={`/blog/${post.id}/`}
          />
        ))}
      </div>
    </section>
  </div>
</Layout>

<style>
  /* Home hero layout */
  .home-hero {
    display: grid;
    gap: 1.5rem;
  }

  /* Keep hero content and actions on one row when space allows */
  .home-hero__content {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    align-items: end;
  }

  /* Lead text width control */
  .home-hero__lead {
    max-width: 50rem;
    font-size: 1.05rem;
  }

  /* CTA buttons */
  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  /* Two-column highlight grid */
  .home-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 1rem;
  }

  /* Shared spotlight card */
  .spotlight {
    display: grid;
    gap: 0.85rem;
    padding: 1.35rem;
  }

  .spotlight > .eyebrow {
    align-self: start;
    /* justify-self: start; */
  }

  /* Accent spotlight variant */
  .spotlight--accent {
    background: var(--surface-accent);
  }

  /* Link list inside the spotlight card */
  .spotlight__links {
    display: grid;
    gap: 0.65rem;
  }

  .spotlight__links a {
    color: var(--accent-strong);
    font-weight: 600;
  }

  /* Simple project list */
  .mini-list {
    display: grid;
    gap: 0.75rem;
  }

  .mini-list a {
    display: grid;
    gap: 0.25rem;
    padding: 0.8rem 0;
    border-top: 1px solid var(--line);
  }

  /* Text link for secondary actions */
  .text-link {
    color: var(--accent-strong);
    font-weight: 700;
  }

  /* Latest posts section */
  .post-section {
    display: grid;
    gap: 1rem;
  }

  /* Section header alignment */
  .post-section__header {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 1rem;
  }

  /* Small top spacing for the section title */
  .post-section__header h2 {
    margin-top: 0.45rem;
  }

  /* Post card grid */
  .post-grid {
    display: grid;
    gap: 1rem;
  }

  @media (max-width: 900px) {
    .home-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 720px) {
    .home-hero__content,
    .post-section__header {
      flex-direction: column;
      align-items: start;
    }
  }
</style>
