---
interface Props {
  tags?: string[];
  searchData?: Array<{
    slug: string;
    title: string;
    description: string;
    body: string;
    tags: string[];
  }>;
}

const { tags = [], searchData = [] } = Astro.props;
---

<section class="search-panel panel">
  <div class="search-panel__header">
    <div>
      <p class="eyebrow">Discover</p>
      <h2>搜索与筛选</h2>
    </div>
    <p class="muted">按标题、摘要、正文和标签快速定位文章。</p>
  </div>

  <div class="search-panel__controls">
    <label class="search-input">
      <span class="sr-only">搜索文章</span>
      <input id="blog-search-input" type="search" placeholder="输入关键词，例如 Astro、建站、搜索…" />
    </label>
    <button type="button" class="search-reset" id="blog-search-reset">清空</button>
  </div>

  <div class="search-panel__tags" aria-label="标签筛选">
    <button type="button" class="tag-filter is-active" data-tag-filter="all">全部</button>
    {tags.map((tag) => (
      <button type="button" class="tag-filter" data-tag-filter={tag.toLowerCase()}>
        #{tag}
      </button>
    ))}
  </div>

  <p id="blog-search-status" class="search-panel__status">正在展示全部文章。</p>
</section>

<script id="blog-search-data" type="application/json" is:inline>{JSON.stringify(searchData)}</script>

<script type="module" is:inline>
  const input = document.getElementById("blog-search-input");
  const resetButton = document.getElementById("blog-search-reset");
  const status = document.getElementById("blog-search-status");
  const cards = Array.from(document.querySelectorAll("[data-post-card]"));
  const tagButtons = Array.from(document.querySelectorAll("[data-tag-filter]"));
  const searchDataElement = document.getElementById("blog-search-data");
  let activeTag = "all";
  let fuse = null;
  let searchableSlugs = null;

  const updateStatus = (visibleCount, query) => {
    if (!status) return;
    if (visibleCount === 0) {
      status.textContent = "没有匹配结果，换个关键词或标签试试。";
      return;
    }

    const tagLabel = activeTag === "all" ? "全部标签" : `标签 #${activeTag}`;
    const searchLabel = query ? `关键词“${query}”` : "全部内容";
    status.textContent = `当前显示 ${visibleCount} 篇文章，范围：${tagLabel} + ${searchLabel}。`;
  };

  const applyFilters = () => {
    const query = input instanceof HTMLInputElement ? input.value.trim() : "";
    let visibleCount = 0;

    cards.forEach((card) => {
      const slug = card.getAttribute("data-slug") || "";
      const tags = (card.getAttribute("data-tags") || "").split("|").filter(Boolean);
      const matchesTag = activeTag === "all" || tags.includes(activeTag);
      const matchesSearch = !query || !searchableSlugs || searchableSlugs.has(slug);
      const visible = matchesTag && matchesSearch;
      card.toggleAttribute("hidden", !visible);
      if (visible) visibleCount += 1;
    });

    updateStatus(visibleCount, query);
  };

  const refreshSearch = async () => {
    const query = input instanceof HTMLInputElement ? input.value.trim() : "";
    if (!query) {
      searchableSlugs = null;
      applyFilters();
      return;
    }

    if (!fuse) {
      const { default: Fuse } = await import("fuse.js");
      const data = JSON.parse(searchDataElement?.textContent || "[]");
      fuse = new Fuse(data, {
        keys: ["title", "description", "body", "tags"],
        threshold: 0.32,
      });
    }

    searchableSlugs = new Set(fuse.search(query).map((entry) => entry.item.slug));
    applyFilters();
  };

  tagButtons.forEach((button) => {
    button.addEventListener("click", () => {
      activeTag = button.getAttribute("data-tag-filter") || "all";
      tagButtons.forEach((item) => item.classList.toggle("is-active", item === button));
      applyFilters();
    });
  });

  input?.addEventListener("input", () => {
    refreshSearch();
  });

  resetButton?.addEventListener("click", () => {
    if (input instanceof HTMLInputElement) input.value = "";
    activeTag = "all";
    searchableSlugs = null;
    tagButtons.forEach((item) => item.classList.toggle("is-active", item.getAttribute("data-tag-filter") === "all"));
    applyFilters();
  });

  applyFilters();
</script>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .search-panel {
    display: grid;
    gap: 1rem;
    padding: 1.25rem;
  }

  .search-panel__header {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: end;
  }

  .search-panel__header h2 {
    margin-top: 0.45rem;
  }

  .search-panel__controls {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.75rem;
  }

  .search-input input {
    width: 100%;
    padding: 0.95rem 1rem;
    border: 1px solid var(--line);
    border-radius: 1rem;
    background: var(--surface-strong);
    color: var(--text);
    outline: none;
  }

  .search-input input:focus {
    border-color: rgba(31, 143, 255, 0.5);
    box-shadow: 0 0 0 4px rgba(31, 143, 255, 0.12);
  }

  .search-reset,
  .tag-filter {
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface-strong);
    color: var(--text-soft);
    cursor: pointer;
    transition: background-color var(--transition), color var(--transition), border-color var(--transition);
  }

  .search-reset {
    padding: 0.85rem 1rem;
    min-width: 5rem;
  }

  .search-panel__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .tag-filter {
    padding: 0.55rem 0.85rem;
  }

  .search-reset:hover,
  .tag-filter:hover,
  .tag-filter.is-active {
    border-color: transparent;
    background: var(--accent-soft);
    color: var(--accent-strong);
  }

  .search-panel__status {
    color: var(--text-faint);
    font-size: 0.94rem;
  }

  @media (max-width: 720px) {
    .search-panel__header,
    .search-panel__controls {
      grid-template-columns: 1fr;
    }
  }
</style>
