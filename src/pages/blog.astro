---
import SearchBox from "../components/SearchBox.astro";
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import BlogCard from "../components/BlogCard.astro";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const allTags = [...new Set(posts.flatMap((post) => post.data.tags ?? []))].sort((a, b) =>
  a.localeCompare(b, "zh-CN")
);

const featuredPosts = posts.slice(0, 3);
const searchData = posts.map((post) => ({
  slug: `/blog/${post.slug}/`,
  title: post.data.title,
  description: post.data.description,
  body: post.body ?? "",
  tags: post.data.tags ?? [],
}));
---

<Layout title="博客 | AntZ Blog" description="简约、清楚、现代化的博客内容首页。">
  <div class="page-stack">
    <section class="panel hero-panel blog-hero">
      <div class="blog-hero__content">
        <div class="section-grid">
          <p class="eyebrow">Editorial Blog</p>
          <h1 class="hero-title">一个更轻、更清楚、更现代的博客首页。</h1>
          <p class="muted blog-hero__lead">
            去掉拖慢加载的大背景图，保留内容本身的层次感。这里聚合最新文章、标签入口和快速搜索，阅读路径更直接。
          </p>
        </div>

        <div class="blog-hero__actions">
          <a class="button-link" href="#post-grid">开始阅读</a>
          <a class="button-link button-link--ghost" href="/">返回首页</a>
        </div>
      </div>

      <div class="metrics">
        <div class="metric">
          <strong>{posts.length}</strong>
          <span class="muted">已发布文章</span>
        </div>
        <div class="metric">
          <strong>{allTags.length}</strong>
          <span class="muted">主题标签</span>
        </div>
        <div class="metric">
          <strong>{posts[0]?.data.pubDate.toLocaleDateString("zh-CN") ?? "待更新"}</strong>
          <span class="muted">最近更新</span>
        </div>
      </div>
    </section>

    <section class="blog-highlights">
      {featuredPosts.map((post, index) => (
        <a class="highlight-card panel" href={`/blog/${post.slug}/`}>
          <span class="highlight-card__index">0{index + 1}</span>
          <div>
            <h2>{post.data.title}</h2>
            <p class="muted">{post.data.description}</p>
          </div>
        </a>
      ))}
    </section>

    <SearchBox tags={allTags} searchData={searchData} />

    <section class="post-section">
      <div class="post-section__header">
        <div>
          <p class="eyebrow">Archive</p>
          <h2>全部文章</h2>
        </div>
        <p class="muted">默认按发布时间倒序排列，适合从最新内容开始浏览。</p>
      </div>

      <div id="post-grid" class="post-grid">
        {posts.map((post) => (
          <BlogCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            cover={post.data.cover}
            tags={post.data.tags}
            href={`/blog/${post.slug}/`}
          />
        ))}
      </div>
    </section>
  </div>
</Layout>

<style>
  .blog-hero {
    display: grid;
    gap: 1.5rem;
  }

  .blog-hero__content {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .blog-hero__lead {
    max-width: 52rem;
    font-size: 1.05rem;
  }

  .blog-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .blog-highlights {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .highlight-card {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
    padding: 1.1rem 1.2rem;
    align-items: start;
    transition: transform var(--transition), box-shadow var(--transition);
  }

  .highlight-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
  }

  .highlight-card__index {
    font-size: 2rem;
    font-weight: 800;
    color: var(--accent);
    line-height: 1;
  }

  .highlight-card p {
    margin-top: 0.55rem;
  }

  .post-section {
    display: grid;
    gap: 1rem;
  }

  .post-section__header {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: end;
  }

  .post-section__header h2 {
    margin-top: 0.45rem;
  }

  .post-grid {
    display: grid;
    gap: 1rem;
  }

  @media (max-width: 900px) {
    .blog-highlights {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 720px) {
    .blog-hero__content,
    .post-section__header {
      flex-direction: column;
      align-items: start;
    }
  }
</style>
