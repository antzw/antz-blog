---
interface Props {
  searchData?: Array<{
    slug: string;
    title: string;
    description: string;
    body: string;
    tags: string[];
  }>;
}

const { searchData = [] } = Astro.props;
---

<script id="blog-search-data" type="application/json" is:inline>{JSON.stringify(searchData)}</script>

<script type="module" is:inline>
  const setupBlogFilters = () => {
    const input = document.getElementById("blog-search-input");
    const resetButton = document.getElementById("blog-search-reset");
    const status = document.getElementById("blog-search-status");
    const selectedTags = document.getElementById("blog-selected-tags");
    const emptyState = document.getElementById("blog-empty-state");
    const filterPanel = document.querySelector("[data-filter-panel]");
    const cards = Array.from(document.querySelectorAll("[data-post-card]"));
    const tagInputs = Array.from(document.querySelectorAll("[data-tag-filter]"));
    const tagLinks = Array.from(document.querySelectorAll("[data-card-tag]"));
    const clearTagButtons = Array.from(document.querySelectorAll("[data-clear-tags]"));
    const searchDataElement = document.getElementById("blog-search-data");
    let fuse = null;
    let searchableSlugs = null;

    if (!input || cards.length === 0 || !searchDataElement) return;

    const getActiveTags = () =>
      tagInputs
        .filter((item) => item instanceof HTMLInputElement && item.checked)
        .map((item) => item.value);

    const hasActiveFilters = () => {
      const query = input instanceof HTMLInputElement ? input.value.trim() : "";
      return query.length > 0 || getActiveTags().length > 0;
    };

    const syncFilterPanel = () => {
      if (!(filterPanel instanceof HTMLDetailsElement)) return;
      if (hasActiveFilters()) {
        filterPanel.open = true;
        return;
      }
      filterPanel.open = !window.matchMedia("(max-width: 720px)").matches;
    };

    const updateSelectedTags = (activeTags) => {
      if (!selectedTags) return;
      selectedTags.textContent = activeTags.length > 0 ? activeTags.map((tag) => `#${tag}`).join(" + ") : "未选择标签";
    };

    const updateStatus = (visibleCount, query) => {
      if (!status) return;
      const activeTags = getActiveTags();
      if (visibleCount === 0) {
        status.textContent = "没有匹配结果。可以减少标签条件，或清空筛选。";
        return;
      }

      const tagLabel = activeTags.length > 0 ? `同时包含 ${activeTags.map((tag) => `#${tag}`).join("、")}` : "全部标签";
      const searchLabel = query ? `关键词“${query}”` : "全部内容";
      status.textContent = `当前显示 ${visibleCount} 篇文章，范围：${tagLabel} + ${searchLabel}。`;
    };

    const applyFilters = () => {
      const query = input instanceof HTMLInputElement ? input.value.trim() : "";
      const activeTags = getActiveTags();
      let visibleCount = 0;

      cards.forEach((card) => {
        const slug = card.getAttribute("data-slug") || "";
        const cardTags = (card.getAttribute("data-tags") || "").split("|").filter(Boolean);
        const matchesTags = activeTags.every((tag) => cardTags.includes(tag));
        const matchesSearch = !query || !searchableSlugs || searchableSlugs.has(slug);
        const visible = matchesTags && matchesSearch;
        card.toggleAttribute("hidden", !visible);
        if (visible) visibleCount += 1;
      });

      if (emptyState) emptyState.toggleAttribute("hidden", visibleCount > 0);
      updateSelectedTags(activeTags);
      updateStatus(visibleCount, query);
      syncFilterPanel();
    };

    const refreshSearch = async () => {
      const query = input instanceof HTMLInputElement ? input.value.trim() : "";
      if (!query) {
        searchableSlugs = null;
        applyFilters();
        return;
      }

      if (!fuse) {
        const { default: Fuse } = await import("fuse.js");
        const data = JSON.parse(searchDataElement.textContent || "[]");
        fuse = new Fuse(data, {
          keys: ["title", "description", "body", "tags"],
          threshold: 0.32,
        });
      }

      searchableSlugs = new Set(fuse.search(query).map((entry) => entry.item.slug));
      applyFilters();
    };

    tagInputs.forEach((tagInput) => {
      tagInput.addEventListener("change", applyFilters);
    });

    tagLinks.forEach((button) => {
      button.addEventListener("click", () => {
        const tag = button.getAttribute("data-card-tag") || "";
        const inputToCheck = tagInputs.find((item) => item instanceof HTMLInputElement && item.value === tag);
        if (inputToCheck instanceof HTMLInputElement) {
          inputToCheck.checked = true;
        }
        applyFilters();
        document.getElementById("blog-search-input")?.scrollIntoView({ behavior: "smooth", block: "center" });
      });
    });

    clearTagButtons.forEach((button) => {
      button.addEventListener("click", () => {
        tagInputs.forEach((tagInput) => {
          if (tagInput instanceof HTMLInputElement) tagInput.checked = false;
        });
        applyFilters();
      });
    });

    input.addEventListener("input", () => {
      refreshSearch();
    });

    resetButton?.addEventListener("click", () => {
      if (input instanceof HTMLInputElement) input.value = "";
      searchableSlugs = null;
      tagInputs.forEach((tagInput) => {
        if (tagInput instanceof HTMLInputElement) tagInput.checked = false;
      });
      applyFilters();
    });

    syncFilterPanel();
    applyFilters();
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupBlogFilters, { once: true });
  } else {
    setupBlogFilters();
  }
</script>
