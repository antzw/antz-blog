---
const contacts = [
  {
    label: "GitHub",
    href: "https://github.com/antzw",
    external: true,
    icon: "github",
  },
  {
    label: "Email",
    href: "mailto:wen_study@outlook.com",
    icon: "email",
  },
  {
    label: "微信",
    note: "微信待补充",
    icon: "wechat",
  },
  {
    label: "LinkedIn",
    note: "LinkedIn 待补充",
    icon: "linkedin",
  },
];
---

<div class="contact-links" aria-label="联系 AntZ">
  {contacts.map((contact) => {
    const icon = (
      <svg aria-hidden="true" viewBox="0 0 24 24">
        {contact.icon === "github" && (
          <path d="M12 .5A11.5 11.5 0 0 0 8.36 22.9c.58.1.8-.25.8-.56v-2c-3.26.7-3.95-1.4-3.95-1.4-.53-1.36-1.3-1.72-1.3-1.72-1.07-.73.08-.72.08-.72 1.18.08 1.8 1.21 1.8 1.21 1.05 1.8 2.75 1.28 3.42.98.1-.76.41-1.28.75-1.57-2.6-.3-5.33-1.3-5.33-5.8 0-1.28.46-2.32 1.2-3.14-.12-.3-.52-1.5.12-3.1 0 0 .98-.32 3.2 1.2a11.05 11.05 0 0 1 5.82 0c2.22-1.52 3.2-1.2 3.2-1.2.64 1.6.24 2.8.12 3.1.75.82 1.2 1.86 1.2 3.14 0 4.52-2.73 5.5-5.34 5.8.42.36.8 1.08.8 2.18v3.04c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z" />
        )}
        {contact.icon === "email" && (
          <path d="M3.75 5h16.5c.97 0 1.75.78 1.75 1.75v10.5c0 .97-.78 1.75-1.75 1.75H3.75C2.78 19 2 18.22 2 17.25V6.75C2 5.78 2.78 5 3.75 5Zm.55 2 7.7 5.2L19.7 7H4.3Zm15.7 1.55-7.44 5.03a1 1 0 0 1-1.12 0L4 8.55V17h16V8.55Z" />
        )}
        {contact.icon === "wechat" && (
          <path d="M9.4 4.2c4.05 0 7.35 2.66 7.35 5.95 0 3.28-3.3 5.94-7.35 5.94-.75 0-1.47-.09-2.15-.27L4.7 17.1l.7-2.12c-2.02-1.1-3.35-2.86-3.35-4.83 0-3.29 3.3-5.95 7.35-5.95Zm-2.5 4.72a.85.85 0 1 0 0-1.7.85.85 0 0 0 0 1.7Zm5 0a.85.85 0 1 0 0-1.7.85.85 0 0 0 0 1.7Zm6.07 1.27c2.3.54 3.98 2.2 3.98 4.17 0 1.48-.94 2.8-2.4 3.6l.5 1.6-1.93-.98c-.52.14-1.08.2-1.66.2-2.74 0-5.08-1.53-5.9-3.66 3.75-.42 6.73-2.35 7.41-4.93Zm-3.04 3.36a.68.68 0 1 0 0-1.36.68.68 0 0 0 0 1.36Zm3.6 0a.68.68 0 1 0 0-1.36.68.68 0 0 0 0 1.36Z" />
        )}
        {contact.icon === "linkedin" && (
          <path d="M5.1 8.6H1.9V22h3.2V8.6ZM3.5 2A1.85 1.85 0 1 0 3.5 5.7 1.85 1.85 0 0 0 3.5 2Zm18.6 12.55c0-4.05-2.16-5.93-5.04-5.93a4.35 4.35 0 0 0-3.92 2.16h-.05V8.6H10V22h3.21v-6.63c0-1.75.33-3.44 2.5-3.44 2.13 0 2.16 2 2.16 3.55V22h3.23v-7.45Z" />
        )}
      </svg>
    );

      <!-- ContactLinks component: renders external contact icons/links (email, github, etc.) -->
    return contact.href ? (
      <a
        class="contact-link"
        href={contact.href}
        aria-label={contact.label}
        title={contact.label}
        target={contact.external ? "_blank" : undefined}
        rel={contact.external ? "noreferrer" : undefined}
      >
        {icon}
        <span>{contact.label}</span>
      </a>
    ) : (
      <span class="contact-link contact-link--placeholder" aria-label={contact.note} title={contact.note}>
        {icon}
        <span>{contact.label}</span>
      </span>
    );
  })}
</div>

<style>
  .contact-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.65rem;
  }

  .contact-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.55rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface-strong);
    color: var(--text-soft);
    font-size: 0.9rem;
    transition: transform var(--transition), color var(--transition), border-color var(--transition), background-color var(--transition);
  }

  .contact-link svg {
    width: 1.05rem;
    height: 1.05rem;
    fill: currentColor;
  }

  a.contact-link:hover {
    transform: translateY(-1px);
    border-color: transparent;
    background: var(--accent-soft);
    color: var(--accent-strong);
  }

  .contact-link--placeholder {
    opacity: 0.62;
    cursor: default;
  }

  @media (max-width: 720px) {
    .contact-links {
      justify-content: center;
    }
  }
</style>
