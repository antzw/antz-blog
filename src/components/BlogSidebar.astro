---
interface SidebarPost {
  slug: string;
  data: {
    title: string;
    pubDate: Date;
    tags?: string[];
  };
}

interface Props {
  posts: SidebarPost[];
  tags?: string[];
  currentSlug?: string;
  variant?: "blog" | "article";
  showFilters?: boolean;
}

const { posts, tags = [], currentSlug = "", showFilters = false } = Astro.props;
const variant = Astro.props.variant ?? (showFilters ? "blog" : "article");
const recentPosts = posts.slice(0, 5);
const years = [...new Set(posts.map((post) => post.data.pubDate.getFullYear()))];
---

<aside class="blog-sidebar" aria-label="博客导航">
  {variant === "blog" ? (
    <>
      <section class="blog-sidebar__section">
        <a class="blog-sidebar__all is-active" href="/blog">全部文章</a>
      </section>

      <details class="blog-sidebar__section blog-sidebar__filter" data-filter-panel>
        <summary>
          <span>搜索与筛选</span>
          <button type="button"  padding="1rem" class="blog-sidebar__reset" id="blog-search-reset">清空</button>
          <span class="blog-sidebar__chevron" aria-hidden="true"></span>
        </summary>

        <div class="blog-sidebar__controls">
          <label class="blog-sidebar__search">
            <span class="sr-only">搜索文章</span>
            <input id="blog-search-input" type="search" placeholder="搜索标题、摘要、正文…" />
          </label>
        </div>

        <div class="blog-sidebar__selected" aria-label="已选标签">
          <span>AND 标签</span>
          <strong id="blog-selected-tags">未选择标签</strong>
        </div>

        {tags.length > 0 && (
          <div class="blog-sidebar__tags">
            {tags.map((tag) => (
              <label class="blog-sidebar__tag">
                <input type="checkbox" value={tag.toLowerCase()} data-tag-filter />
                <span>#{tag}</span>
              </label>
            ))}
          </div>
        )}

        <p id="blog-search-status" class="blog-sidebar__status">正在展示全部文章。</p>
      </details>

      <section class="blog-sidebar__section blog-sidebar__archive">
        <h2>归档</h2>
        <div class="blog-sidebar__years">
          {years.map((year) => (
            <a href={`/blog#archive-${year}`}>{year}</a>
          ))}
        </div>
      </section>

      <section class="blog-sidebar__section">
        <h2>近期文档</h2>
        <div class="blog-sidebar__recent">
          {recentPosts.map((post) => (
            <a href={`/blog/${post.slug}/`}>
              <span>{post.data.title}</span>
              <small>{post.data.pubDate.toLocaleDateString("zh-CN")}</small>
            </a>
          ))}
        </div>
      </section>
    </>
  ) : (
    <section class="blog-sidebar__section">
      <a class="blog-sidebar__title-link" href="/blog">全部文档</a>
      <div class="blog-sidebar__docs">
        {posts.map((post) => (
          <a class:list={[post.slug === currentSlug && "is-active"]} href={`/blog/${post.slug}/`}>
            <span>{post.data.title}</span>
            <small>{post.data.pubDate.toLocaleDateString("zh-CN")}</small>
          </a>
        ))}
      </div>
    </section>
  )}
</aside>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .blog-sidebar {
    display: grid;
    gap: 1rem;
    align-self: start;
    position: sticky;
    top: 6.2rem;
  }

  .blog-sidebar__section {
    display: grid;
    gap: 0.8rem;
    padding: 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
  }

  .blog-sidebar h2 {
    font-size: 0.95rem;
    color: var(--text);
  }

  .blog-sidebar__all,
  .blog-sidebar__years a,
  .blog-sidebar__recent a,
  .blog-sidebar__docs a {
    display: block;
    color: var(--text-soft);
    font-size: 0.94rem;
    transition: color var(--transition);
  }

  .blog-sidebar__all:hover,
  .blog-sidebar__all.is-active,
  .blog-sidebar__years a:hover,
  .blog-sidebar__recent a:hover,
  .blog-sidebar__docs a:hover,
  .blog-sidebar__docs a.is-active {
    color: var(--accent-strong);
  }

  .blog-sidebar__title-link {
    color: var(--text);
    font-size: 0.95rem;
    font-weight: 700;
    transition: color var(--transition);
  }

  .blog-sidebar__title-link:hover {
    color: var(--accent-strong);
  }

  .blog-sidebar__filter {
    padding: 0;
  }

  .blog-sidebar__filter summary {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem;
    color: var(--text);
    cursor: pointer;
    font-weight: 700;
    list-style: none;
  }

  .blog-sidebar__filter summary::-webkit-details-marker {
    display: none;
  }

  .blog-sidebar__chevron {
    width: 0.55rem;
    height: 0.55rem;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(45deg);
    transition: transform var(--transition);
  }

  .blog-sidebar__filter[open] .blog-sidebar__chevron {
    transform: rotate(225deg);
  }

  .blog-sidebar__filter[open] {
    padding-bottom: 1rem;
  }

  .blog-sidebar__controls,
  .blog-sidebar__selected,
  .blog-sidebar__tags,
  .blog-sidebar__status {
    margin-inline: 1rem;
  }

  .blog-sidebar__controls {
    display: grid;
    gap: 0.65rem;
  }

  .blog-sidebar__search input {
    width: 100%;
    padding: 0.75rem 0.85rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface-strong);
    color: var(--text);
    outline: none;
  }

  .blog-sidebar__search input:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-soft);
  }

  .blog-sidebar__reset {
    padding: 0.35rem 0.65rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface-strong);
    color: var(--text-soft);
    cursor: pointer;
    font-size: 0.82rem;
  }

  .blog-sidebar__reset:hover {
    border-color: transparent;
    background: var(--accent-soft);
    color: var(--accent-strong);
  }

  .blog-sidebar__selected {
    display: grid;
    gap: 0.25rem;
    color: var(--text-faint);
    font-size: 0.9rem;
  }

  .blog-sidebar__selected strong {
    color: var(--accent-strong);
    font-size: 0.92rem;
  }

  .blog-sidebar__tags {
    display: grid;
    gap: 0.55rem;
    max-height: 15rem;
    overflow-y: auto;
    padding-right: 0.2rem;
  }

  .blog-sidebar__tag {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--text-soft);
    font-size: 0.92rem;
    cursor: pointer;
  }

  .blog-sidebar__tag input {
    width: 1rem;
    height: 1rem;
    accent-color: var(--accent);
  }

  .blog-sidebar__status {
    color: var(--text-faint);
    font-size: 0.9rem;
  }

  .blog-sidebar__years {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .blog-sidebar__years a {
    padding: 0.25rem 0.55rem;
    border-radius: 999px;
    background: var(--surface-muted);
  }

  .blog-sidebar__docs {
    display: grid;
    gap: 0.15rem;
    max-height: calc(100vh - 12rem);
    overflow-y: auto;
    padding-right: 0.2rem;
  }

  .blog-sidebar__recent {
    display: grid;
    gap: 0.25rem;
  }

  .blog-sidebar__recent a {
    display: grid;
    gap: 0.2rem;
    padding: 0.45rem 0;
  }

  .blog-sidebar__recent small {
    color: var(--text-faint);
    font-size: 0.78rem;
  }

  .blog-sidebar__docs a {
    display: grid;
    gap: 0.2rem;
    padding: 0.55rem 0.65rem;
    border-radius: var(--radius-sm);
  }

  .blog-sidebar__docs a.is-active {
    background: var(--accent-soft);
  }

  .blog-sidebar__docs small {
    color: var(--text-faint);
    font-size: 0.78rem;
  }

  @media (max-width: 1080px) {
    .blog-sidebar {
      position: static;
      grid-template-columns: 1fr;
    }

    .blog-sidebar__docs {
      max-height: 18rem;
    }
  }
</style>
