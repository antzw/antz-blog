---
interface Props {
  title: string;
  description?: string;
  pubDate: Date | string;
  cover?: string;
  tags?: string[];
  href: string;
  filterTags?: boolean;
}

const { title, description, pubDate, cover, tags = [], href, filterTags = false } = Astro.props;

const date = typeof pubDate === "string" ? new Date(pubDate) : pubDate;
const formattedDate = Number.isNaN(date.getTime())
  ? "待补充日期"
  : date.toLocaleDateString("zh-CN", {
      year: "numeric",
      month: "short",
      day: "numeric",
    });
---

  <!-- Reusable article preview card -->
<article class="blog-card" data-post-card data-slug={href} data-tags={tags.join("|").toLowerCase()}>
  <div class="blog-card__inner">
    <div class="blog-card__body">
      <div class="blog-card__meta">
        <span>{formattedDate}</span>
        {tags.length > 0 && <span>{tags.length} 个标签</span>}
      </div>

      <h3 class="blog-card__title">
        <a href={href}>{title}</a>
      </h3>

      {description && <p class="blog-card__description">{description}</p>}

      {tags.length > 0 && (
        <div class="blog-card__tags">
          {tags.map((tag) => (
            filterTags ? (
              <button type="button" class="blog-card__tag" data-card-tag={tag.toLowerCase()}>#{tag}</button>
            ) : (
              <span class="blog-card__tag">#{tag}</span>
            )
          ))}
        </div>
      )}

      <a class="blog-card__link" href={href}>阅读全文</a>
    </div>

    <div class:list={["blog-card__cover", !cover && "blog-card__cover--placeholder"]}>
      {cover ? (
        <img src={cover} alt={title} width="480" height="320" loading="lazy" decoding="async" />
      ) : (
        <div class="blog-card__fallback">
          <strong>{title.slice(0, 1)}</strong>
          <span>Content</span>
        </div>
      )}
    </div>
  </div>
</article>

<style>
  /* Card wrapper */
  .blog-card {
    display: block;
  }

  /* Main two-column card layout */
  .blog-card__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(220px, 0.95fr);
    gap: 1.25rem;
    padding: 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface-strong);
    box-shadow: var(--shadow-sm);
    transition: transform var(--transition), box-shadow var(--transition), border-color var(--transition);
  }

  /* Hover interaction */
  .blog-card:hover .blog-card__inner {
    transform: translateY(-2px);
    border-color: var(--line-strong);
    box-shadow: var(--shadow-lg);
  }

  /* Text content column */
  .blog-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  /* Meta row (date + tag count) */
  .blog-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    color: var(--text-faint);
    font-size: 0.92rem;
  }

  /* Title typography */
  .blog-card__title {
    font-size: clamp(1.25rem, 2vw, 1.55rem);
  }

  .blog-card__title a:hover {
    color: var(--accent-strong);
  }

  .blog-card__description {
    color: var(--text-soft);
  }

  /* Tags row */
  .blog-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  /* Shared tag style for span/button variants */
  .blog-card__tag {
    display: inline-flex;
    align-items: center;
    padding: 0.35rem 0.7rem;
    border: 0;
    border-radius: 999px;
    background: var(--surface-muted);
    color: var(--text-soft);
    font-size: 0.86rem;
    transition: background-color var(--transition), color var(--transition);
  }

  button.blog-card__tag {
    cursor: pointer;
  }

  button.blog-card__tag:hover {
    background: var(--accent-soft);
    color: var(--accent-strong);
  }

  /* Read more link */
  .blog-card__link {
    width: fit-content;
    margin-top: auto;
    color: var(--accent-strong);
    font-weight: 700;
  }

  /* Cover media container */
  .blog-card__cover {
    min-height: 220px;
    overflow: hidden;
    border-radius: calc(var(--radius-lg) - 8px);
    background: var(--surface-accent);
  }

  .blog-card__cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .blog-card__cover--placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Placeholder cover content */
  .blog-card__fallback {
    display: grid;
    gap: 0.45rem;
    place-items: center;
    color: var(--accent-strong);
    text-transform: uppercase;
    letter-spacing: 0;
  }

  .blog-card__fallback strong {
    font-size: 3rem;
    font-family: var(--font-heading);
  }

  @media (max-width: 820px) {
    .blog-card__inner {
      grid-template-columns: 1fr;
    }

    .blog-card__cover {
      min-height: 180px;
      order: -1;
    }
  }
</style>
