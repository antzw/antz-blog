---
import { type CollectionEntry, getCollection, render } from "astro:content";
import BlogSidebar from "../../components/BlogSidebar.astro";
import TableOfContents from "../../components/TableOfContents.astro";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.flatMap((post) => {
    if (!post.id) return [];

    return [
      {
        params: { slug: post.id },
        props: post,
      },
    ];
  });
}

type Props = CollectionEntry<"blog">;
const post = Astro.props as Props;
const { Content, headings } = await render(post);
const tags = post.data.tags ?? [];
const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const tocHeadings = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

<Layout title={`${post.data.title} | AntZ Blog`} description={post.data.description}>
  <div class:list={["article-layout", tocHeadings.length === 0 && "article-layout--no-toc"]}>
    <!-- Article page layout: left sidebar for navigation, main content area, optional right sidebar for TOC -->
    <BlogSidebar posts={posts} currentSlug={post.id} variant="article" />

    <article class="panel article-page">
      <header class="article-hero prose">
        <p class="eyebrow">Article</p>
        <h1>{post.data.title}</h1>
        <p class="muted article-hero__description">{post.data.description}</p>

        <div class="article-hero__meta">
          <span class="chip chip--accent">{post.data.pubDate.toLocaleDateString("zh-CN")}</span>
          {tags.map((tag) => (
            <span class="chip">#{tag}</span>
          ))}
        </div>
      </header>

      <div class="prose article-content">
        <Content />
      </div>
    </article>

    <TableOfContents headings={tocHeadings} />
  </div>
</Layout>

<style>
  .article-layout {
    display: grid;
    grid-template-columns: minmax(220px, 0.28fr) minmax(0, var(--reading-width)) minmax(180px, 0.24fr);
    gap: 1.25rem;
    align-items: start;
    justify-content: center;
  }

  .article-layout--no-toc {
    grid-template-columns: minmax(220px, 0.28fr) minmax(0, var(--reading-width));
  }

  .article-page {
    padding: clamp(1.2rem, 2vw, 2rem);
    background: var(--surface-strong);
  }

  .article-hero {
    display: grid;
    gap: 1rem;
    margin-bottom: 1.8rem;
  }

  .article-hero__description {
    font-size: 1.05rem;
  }

  .article-hero__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .article-content {
    color: var(--text);
  }

  .article-content :global(h2),
  .article-content :global(h3),
  .article-content :global(h4) {
    margin-top: 2rem;
  }

  @media (max-width: 1080px) {
    .article-layout,
    .article-layout--no-toc {
      grid-template-columns: 1fr;
    }
  }
  </style>
