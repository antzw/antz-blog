<!-- BackToTop component: floating button that scrolls the page to the top when clicked -->
<button class="back-to-top" type="button" aria-label="返回顶部" title="Back to top">
  <span class="back-to-top__arrow" aria-hidden="true"></span>
</button>

<!-- Inline script: toggles visibility and handles click to smooth-scroll to top -->
<script is:inline>
  const backToTopButton = document.querySelector(".back-to-top");

  const updateBackToTop = () => {
    if (!(backToTopButton instanceof HTMLButtonElement)) return;
    backToTopButton.classList.toggle("is-visible", window.scrollY > 320);
  };

  backToTopButton?.addEventListener("click", () => {
    window.scrollTo({ top: 0, behavior: "smooth" });
  });

  updateBackToTop();
  window.addEventListener("scroll", updateBackToTop, { passive: true });
</script>

<!-- Styles: fixed circular button with subtle surface, shadow, and reveal animation -->
<style>
  .back-to-top {
    position: fixed;
    right: max(1rem, env(safe-area-inset-right));
    bottom: max(1rem, env(safe-area-inset-bottom));
    z-index: 60;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    color: var(--accent-strong);
    box-shadow: var(--shadow-lg);
    cursor: pointer;
    opacity: 0;
    pointer-events: none;
    transform: translateY(0.75rem);
    transition: opacity var(--transition), transform var(--transition), background-color var(--transition);
    backdrop-filter: blur(16px);
  }

  .back-to-top.is-visible {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .back-to-top:hover {
    background: var(--accent-soft);
  }

  .back-to-top__arrow {
    width: 0.85rem;
    height: 0.85rem;
    border-top: 2px solid currentColor;
    border-left: 2px solid currentColor;
    transform: translateY(0.15rem) rotate(45deg);
    animation: back-to-top-pulse 1.4s ease-in-out infinite;
  }

  @keyframes back-to-top-pulse {
    0%,
    100% {
      transform: translateY(0.2rem) rotate(45deg);
    }

    50% {
      transform: translateY(-0.1rem) rotate(45deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .back-to-top__arrow {
      animation: none;
    }
  }
</style>
