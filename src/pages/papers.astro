---
import ContactLinks from "../components/ContactLinks.astro";
import Layout from "../layouts/Layout.astro";

const papers = [
  {
    title: "大模型工具使用与个人知识系统",
    summary: "关注 LLM 如何进入个人写作、检索、自动化和代码协作流程。",
    year: "2026",
    keywords: ["LLM", "Tools", "Knowledge"],
    status: "阅读中",
    links: [
      { name: "Nature", url: "https://arxiv.org/abs/xxxx.xxxxx" }
    ]
  },
  {
    title: "静态站点生成器与内容工程",
    summary: "比较内容集合、构建期数据处理和前端交互在个人网站中的边界。",
    year: "2025",
    keywords: ["Astro", "SSG", "Content"],
    status: "整理中",
    links: [
      { name: "arXiv", url: "https://arxiv.org/abs/xxxx.xxxxx" }
    ]
  },
  {
    title: "搜索体验与信息发现",
    summary: "记录离线搜索、标签筛选、目录和归档对长期内容库的影响。",
    year: "2025",
    keywords: ["Search", "UX", "IA"],
    status: "待扩展",
    links: [
      { name: "arXiv", url: "https://arxiv.org/abs/xxxx.xxxxx" }
    ]
  },
];
---

<Layout title="论文 | AntZ Blog" description="AntZ 的论文阅读与研究笔记索引。">
  <div class="page-stack">
    <!-- Hero: paper and reading overview -->
    <section class="panel hero-panel page-hero">
      <p class="eyebrow">Papers</p>
      <h1 class="hero-title">我的论文</h1>
      <p class="muted">这里用于整理论文、研究问题和阅读笔记。当前内容为占位结构，不生成无效外链。</p>
    </section>

    <!-- Paper cards list -->
    <section class="paper-list">
      {papers.map((paper) => (
        <article class="panel paper-card">
          <div class="paper-card__meta">
            <span class="chip chip--accent">{paper.year}</span>
            <span class="chip">{paper.status}</span>
          </div>
          <h2>{paper.title}</h2>
          <p class="muted">{paper.summary}</p>
          <div class="chip-list">
            {paper.keywords.map((keyword) => (
              <span class="chip">#{keyword}</span>
            ))}
          </div>
          <section class="placeholder-link">
            {paper.links.map((link) => (
              <p class="muted">
                论文下载地址
                <a class="text-link" href={link.url} target="_blank" rel="noopener noreferrer">
                  <span class="chip">
                  {link.name }: {link.url}
                  </span>
                </a>
              </p>
            ))}
          </section>
        </article>
      ))}
    </section>
  </div>
</Layout>

<style>
  /* Shared layout for hero and cards */
  .page-hero,
  .paper-card {
    display: grid;
    gap: 1rem;
  }

  /* Keep the hero copy from stretching too wide */
  .page-hero p:last-child {
    max-width: 50rem;
  }

  /* List spacing */
  .paper-list {
    display: grid;
    gap: 1rem;
  }

  /* Card padding */
  .paper-card {
    padding: 1.25rem;
  }

  /* Meta row for year and status */
  .paper-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  /* Placeholder text for future links */
  .placeholder-link {
    color: var(--text-faint);
    font-size: 0.92rem;
  }
</style>
