---
import { getCollection } from "astro:content";

const posts = await getCollection("blog");
---

<html lang="zh">
  <head>
    <meta charset="UTF-8" />
    <title>博客列表</title>
  </head>
  <body>
    <h1>📚博客文章列表</h1>
    <ul>
     {posts.map((post) => (
        <li>
          <a href={`/blog/${post.slug}/`}>{post.data.title}</a>（发表于 {post.data.pubDate.toLocaleDateString()}）
        </li>
      ))}
    </ul>
  </body>
</html>
